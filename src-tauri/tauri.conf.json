{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Door Accessible Assistant",
  "version": "0.1.0",
  "identifier": "org.opendoordesign.accessibleassistant",
  "build": {
    "frontendDist": ".."
  },
  "app": {
    "windows": [
      {
        "title": "Open Door Accessible Assistant",
        "width": 1120,
        "height": 800,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
